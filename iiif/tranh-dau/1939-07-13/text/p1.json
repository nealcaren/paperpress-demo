   "type": "Annotation",
   "motivation": "supplementing",
   "body": {
    "type": "TextualBody",
    "value": "Louis XVI tuyên the nhìn nhân Hiên pháp.",
    "format": "text/plain"
   },
   "target": "https://nealcaren.github.io/paperpress-demo/iiif/tranh-dau/1939-07-13/canvas/p1#xywh=1965,6427,925,62"
