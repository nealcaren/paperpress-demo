   "type": "Annotation",
   "motivation": "supplementing",
   "body": {
    "type": "TextualBody",
    "value": "The Silent Sentinels",
    "format": "text/plain"
   },
   "target": "https://nealcaren.github.io/paperpress-demo/iiif/suffragist/1917-01-24/canvas/p11#xywh=3624,5667,1221,162"
  },
