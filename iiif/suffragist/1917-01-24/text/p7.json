   "body": {
    "type": "TextualBody",
    "value": "Connressinnal Rnion for Woman Suffrage",
    "format": "text/plain"
   },
   "target": "https://nealcaren.github.io/paperpress-demo/iiif/suffragist/1917-01-24/canvas/p7#xywh=2776,8283,2912,194"
